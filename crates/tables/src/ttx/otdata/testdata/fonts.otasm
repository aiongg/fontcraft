table GSUB
@gsub
  u32 0x00010001
  o16 vs_scripts gsub
  o16 vs_features gsub
  o16 vs_lookups gsub
  o32 vs_fv gsub
@vs_scripts
  u16 1
  tag DFLT
  o16 vs_dflt vs_scripts
@vs_dflt
  o16 vs_ls vs_dflt
  u16 0
@vs_ls
  u16 0 0xFFFF 1 0
@vs_features
  u16 1
  tag rvrn
  o16 vs_f0 vs_features
@vs_f0
  u16 0 0
@vs_lookups
  u16 1
  o16 vs_l0 vs_lookups
@vs_l0
  u16 7 0 1
  o16 vs_ext vs_l0
@vs_ext
  u16 1 4
  o32 vs_lig vs_ext
@vs_lig
  u16 1
  o16 vs_ligcov vs_lig
  u16 1
  o16 vs_ligset vs_lig
@vs_ligcov
  u16 1 1 6
@vs_ligset
  u16 1
  o16 vs_lig0 vs_ligset
@vs_lig0
  u16 8 2 7
@vs_fv
  u32 0x00010000 1
  o32 vs_cs vs_fv
  o32 vs_fts vs_fv
@vs_cs
  u16 1
  o32 vs_cond vs_cs
@vs_cond
  u16 1 0
  f2 0.5 1
@vs_fts
  u32 0x00010000
  u16 1 0
  o32 vs_fsub vs_fts
@vs_fsub
  u16 0 1 0
