                <MarkIndex value="65535"/>
                <CurrentIndex value="65535"/>
              </Transition>
              <Transition onGlyphClass="5">
                <NewState value="0"/>
                <MarkIndex value="1"/>
                <CurrentIndex value="0"/>
              </Transition>
            </State>
            <PerGlyphLookup index="0">
              <Lookup glyph="B" value="B"/>
              <Lookup glyph="D" value="D"/>
              <Lookup glyph="E" value="A"/>
            </PerGlyphLookup>
            <PerGlyphLookup index="1">
              <Lookup glyph="A" value="B"/>
              <Lookup glyph="C" value="D"/>
              <Lookup glyph="D" value="A"/>
            </PerGlyphLookup>
          </StateTable>
        </ContextualMorph>
      </MorphSubtable>
      <MorphSubtable index="1">
        <!-- StructLength=88 -->
        <CoverageFlags value="0"/>
        <!-- MorphType=2 -->
        <SubFeatureFlags value="0x00000004"/>
        <LigatureMorph>
          <StateTable>
            <!-- GlyphClassCount=6 -->
            <GlyphClass glyph="f" value="4"/>
            <GlyphClass glyph="i" value="5"/>
            <State index="0">
              <Transition onGlyphClass="0">
                <NewState value="0"/>
              </Transition>
              <Transition onGlyphClass="1">
                <NewState value="0"/>
              </Transition>
              <Transition onGlyphClass="2">
