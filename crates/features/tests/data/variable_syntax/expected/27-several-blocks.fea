# font: mapped
@Upper = [A B C];

lookup shared {
sub a by a.sc;
} shared;

feature smcp {
lookup shared;
} smcp;

feature rvrn {

} rvrn;

conditionset conditionset_1 {
    wght 650.0 900.0;
} conditionset_1;

variation rvrn conditionset_1 {
sub dollar by dollar.bold;
} rvrn;


feature cpsp {
pos @Upper (wght=400.0,wdth=100.0,opsz=12.0:5 wght=900.0:10);
} cpsp;
