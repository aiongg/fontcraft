# font: mapped
feature rvrn {

} rvrn;

conditionset conditionset_1 {
    wght 650.0 900.0;
} conditionset_1;

variation rvrn conditionset_1 {
sub dollar by dollar.bold;
} rvrn;

conditionset conditionset_2 {
    wght 100.0 250.0;
} conditionset_2;

variation rvrn conditionset_2 {
sub dollar by dollar.light;
} rvrn;

