# font: mapped
feature rvrn {

} rvrn;

conditionset conditionset_1 {
    wght 650.0 900.0;
} conditionset_1;

variation rvrn conditionset_1 {
sub dollar by dollar.bold;
} rvrn;


feature salt {

} salt;

conditionset conditionset_2 {
    wdth 75.0 87.5;
} conditionset_2;

variation salt conditionset_2 {
sub a by a.narrow;
} salt;

